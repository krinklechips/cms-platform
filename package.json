{
  "name": "cms-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "node server/index.js",
    "dev:client": "cd client && npx vite --port 5173",
    "dev": "npx concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "start": "node server/index.js",
    "build:client": "cd client && npx vite build",
    "build": "npm run build:client",
    "check": "node --check server/index.js",
    "test": "node --test"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "formidable": "^3.5.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}

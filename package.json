{
  "name": "serviette-cms",
  "version": "0.1.0",
  "description": "Serviette Labs multi-tenant CMS (Payload) — Roomchang is tenant #1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:dependency-security": "node --import tsx --test tests/dependency-*.test.ts tests/native-lockfile.test.ts",
    "lint": "eslint .",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --port 3100",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev --port 3100",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "node scripts/verify-runtime.mjs && NODE_OPTIONS=--no-deprecation payload migrate --forceAcceptWarning && node scripts/verify-migrations.mjs && NODE_OPTIONS=--no-deprecation next start -p ${PORT:-3100}",
    "sync:roomchang": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/sync-roomchang.ts",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.91.0",
    "@payloadcms/db-sqlite": "3.91.0",
    "@payloadcms/live-preview-react": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/plugin-multi-tenant": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "@payloadcms/storage-s3": "3.91.0",
    "@payloadcms/ui": "3.91.0",
    "@supabase/supabase-js": "^2.49.4",
    "cross-env": "10.1.0",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "next": "16.4.2",
    "nodemailer": "10.1.7",
    "patch-package": "8.0.1",
    "payload": "3.91.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "happy-dom": "21.0.4",
    "tsx": "4.22.4",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "payload@3.91.0": {
      "undici": "7.30.1"
    },
    "monaco-editor@0.57.0": {
      "dompurify": "3.4.17"
    },
    "@lexical/headless@0.50.0": {
      "happy-dom": "21.0.4"
    },
    "@esbuild-kit/core-utils@3.3.2": {
      "esbuild": "0.25.12"
    },
    "esbuild-register@3.6.0": {
      "esbuild": "0.25.12"
    }
  },
  "engines": {
    "node": ">=20.18.1"
  }
}

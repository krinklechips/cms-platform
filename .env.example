NODE_ENV=development
PORT=4100

# Database
PLATFORM_DB_PATH=./server/data/platform.db
PLATFORM_SESSION_SECRET=change-me-platform-session-secret
PLATFORM_BOOTSTRAP_SECRET=change-me-bootstrap-secret

# Initial platform owner (seed)
PLATFORM_OWNER_EMAIL=you@example.com

# Seed tenant (neutral demo tenant for first boot)
SEED_TENANT_SLUG=demo
SEED_TENANT_NAME=Demo Tenant
SEED_TENANT_PUBLIC_SITE_URL=https://example.com
SEED_TENANT_CMS_DOMAIN=https://cms.example.com
SEED_TENANT_LOGO_URL=/logo.png
SEED_TENANT_SUPPORT_EMAIL=support@example.com
SEED_TENANT_PRIMARY_COLOR=#2563EB

# Frontend(s) allowed to call the platform API
PLATFORM_CORS_ORIGIN=http://localhost:5173

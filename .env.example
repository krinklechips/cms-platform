NODE_ENV=development
PORT=4100

# Database
PLATFORM_DB_PATH=./server/data/platform.db
PLATFORM_SESSION_SECRET=change-me-platform-session-secret

# Initial platform owner (seed)
PLATFORM_OWNER_EMAIL=you@example.com

# Seed tenant (keeps Kardal isolated as one tenant in the new platform model)
SEED_TENANT_SLUG=kardal
SEED_TENANT_NAME=Kardal
SEED_TENANT_PUBLIC_SITE_URL=https://kardal.org
SEED_TENANT_CMS_DOMAIN=https://cms.kardal.org
SEED_TENANT_LOGO_URL=/kardal-logo.png
SEED_TENANT_SUPPORT_EMAIL=support@kardal.org
SEED_TENANT_PRIMARY_COLOR=#7F3E98

# Frontend(s) allowed to call the platform API
PLATFORM_CORS_ORIGIN=http://localhost:5173
